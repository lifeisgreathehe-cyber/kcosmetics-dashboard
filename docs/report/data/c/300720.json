",32.4],["2024Q3",30.5],["2024Q4",22.0],["2025Q1",17.8],["2025Q2",25.9],["2025Q3",26.1],["2025Q4",19.1],["2026Q1",17.8],["2026Q2",29.7],["2026Q3",21.7]]}],"peers":[{"code":"300720","name":"한일시멘트","self":true,"mcap":1105413,"fy":"2025","equity":1868390,"rev":1423860,"op":132740,"ni":74200},{"code":"038500","name":"삼표시멘트","group":"시멘트·레미콘","mcap":611856,"fy":"2025","rev":676930,"op":76580,"ni":40810,"equity":786140},{"code":"003300","name":"한일홀딩스","group":"시멘트·레미콘","mcap":506917,"fy":"2025","rev":1930490,"op":123220,"ni":31570,"equity":1679510},{"code":"183190","name":"아세아시멘트","group":"시멘트·레미콘","mcap":289267,"fy":"2025","rev":1022790,"op":77130,"ni":16890,"equity":1089140},{"code":"023410","name":"유진기업","group":"시멘트·레미콘","mcap":251621,"fy":null,"equity":null},{"code":"001520","name":"동양","group":"시멘트·레미콘","mcap":210400,"fy":null,"equity":null},{"code":"004980","name":"성신양회","group":"시멘트·레미콘","mcap":168621,"fy":null,"equity":null},{"code":"079650","name":"서산","group":"시멘트·레미콘","mcap":108800,"fy":null,"equity":null},{"code":"014580","name":"태경비케이","group":"시멘트·레미콘","mcap":91289,"fy":null,"equity":null}],"manual":{},"src":{"deep":{"products":"시멘트, 레미탈(모르타르), 레미콘, 골재","competition":"쌍용C&E(비상장), 아세아·삼표·성신양회·한라(아세아 계열).","customers":"레미콘사, 건설사, 레미탈 유통.","sourcing":"석회석(자체 광산), 유연탄(호주·러시아), 폐합성수지, 전기.","moat":{"sources":["과점 지위","석회석 광산","운송·유통망"],"reason":"시멘트는 운송비가 커서 수입재가 들어오기 어렵고 7개사 과점이에요."},"outlook":{"summary":"2026년 바닥, 2027년 하반기 회복.","upside":["착공 회복","대체연료 원가 절감"],"risks":["수요 추가 감소","탄소 비용","가격 인하 압력"]},"explain":{"title":"국내 시멘트 1위권(한일시멘트, 한일현대시멘트 흡수합병)","sections":[{"h":"시멘트는 어떻게 만들고, 이익은 무엇이 정하나요?","p":"석회석(약 80%)과 점토·철광석·규석을 섞어 1,450℃ 소성로(킬른)에서 구운 '클링커'를 석고와 함께 곱게 갈면 시멘트예요. 원가는 연료(유연탄·폐합성수지) 25~30%, 전기 15~20%, 감가상각이 커서 고정비 장사예요. 그래서 이익은 ① 출하량(가동률) ② 톤당 판가 ③ 유연탄 가격·환율 세 가지가 정해요. 국내 시멘트 수요는 2025년 3,810만 톤으로 34년 만에 최저였고, 2026년 상반기 공장 가동률은 45~59%에 그쳤어요. 유연탄이 싸져 원가는 내려왔지만 물량이 줄어 고정비 부담이 커졌어요."},{"h":"레미콘·파일·골재는 시멘트와 무엇이 다른가요?","p":"레미콘(시멘트+골재+물을 섞은 굳지 않은 콘크리트)은 90분 안에 타설해야 해서 공장 반경 30~40km 안에서만 팔리는 '지역 장사'예요. 시멘트 값 인상을 건설사에 그대로 넘기기 어려워 마진이 1~4%로 얇아요. PHC 파일(기초 말뚝)은 아파트·공장 기초공사에 가장 먼저 들어가 착공의 '선행' 제품이고, 골재(모래·자갈)는 지역 인허가 사업이에요. 시멘트 업계는 7개사 과점이라 가격 담합 규제·탄소배출권(시멘트는 국내 배출량의 약 5%)이 함께 따라와요."},{"h":"한일시멘트의 위치","p":"단양·영월 공장(연산 약 1,500만 톤 안팎, 한일현대시멘트 합병 후)을 가진 시멘트 1위권 회사이고, 레미탈(포장 모르타르) 국내 1위예요. 2025년 영업이익은 1,318억원(-51.4%)으로 반 토막이 났고, 2026년 상반기 가동률은 58.9%로 업계에서 가장 높았어요. 대체연료(폐합성수지) 사용 비율 48.8%로 유연탄 의존을 줄이고 있고, 2021~2028년 6,514억원을 친환경 설비에 투자해요."},{"h":"시멘트 가격과 유연탄","p":"시멘트 가격은 2021~2023년 유연탄 급등 때 톤당 7만원대에서 11만원대로 40% 넘게 올랐어요. 2024~2026년 유연탄이 내려왔지만 가격은 크게 내리지 않아 톤당 마진은 여전히 과거보다 높아요. 문제는 물량이에요. 수요가 2025년 3,810만 톤(34년 최저)까지 줄어 고정비가 이익을 깎고 있어요."}]},"diagnosis":{"verdict":"수요 바닥, 마진은 양호","summary":"이익 감소는 착공 급감에 따른 출하 감소라는 사이클 요인이에요. 원가(유연탄) 하락과 대체연료 확대, 과점 가격 구조는 구조적 강점이에요. 2027년 하반기 착공 회복이 확인되면 이익이 빠르게 돌아와요.","cycle":["시멘트 출하량","유연탄·전기요금"],"structural":["과점 지위","대체연료 비중 48.8%"],"check":["월별 시멘트 출하지수","주택 착공","탄소배출권 가격"]}},"rev":{"tone":"neu","title":"수요 바닥의 고배당 시멘트 1위","trend":["매출 성장률(전년 같은 분기 대비)이 -19% → -2% → -9% → -7%였고, 2026Q3 매출은 3,322억원이었어요.","영업이익률은 2025Q4 4.9%에서 2026Q3 8.6%로 올랐어요.","최근 4개 분기 순이익 합계는 1,266억원이에요."],"eval":"최근 4개 분기 순이익 1,266억원(일회성 포함)이에요. 정상 이익 1,100억원 기준 시가총액 1.12조원은 PER 10배, 배당수익률 6.5%예요.","watch":["출하량","가격 협상"],"news":[{"date":"2026-11-21","title":"한일시멘트 2026년 3분기 실적(DART 연결 집계)","url":"https://lifeisgreathehe-cyber.github.io/earnings-dashboard/company.html?c=300720","src":"실적 랭킹(DART)","read":"3분기 매출 3,322억원, 영업이익 285억원, 순이익 593억원(일회성 이익 포함)이에요. 2분기 영업이익 616억원으로 성수기 이익은 회복했어요. 배당수익률 6.5%예요.","impact":"0"},{"date":"2026-11-15","title":"2027년 주택 착공 32만 호 전망…데이터센터 수주 30~40조원","url":"https://news.mtn.co.kr/article/2026111419513657472","src":"MTN","read":"업계·연구원은 2027년 주택 착공을 32만 호(민간 23만, 공공 9만)로 2026년보다 늘 것으로 봤어요. 삼성전자 평택 P5 공사 재개와 2030년까지 데이터센터 4GW(수주 30~40조원, 하나증권)가 건축 일감을 늘리고, 2027년 미분양은 6만 호 안팎, 수도권 아파트 매매가 +5%·전세 +8%를 예상했어요. 착공 회복은 2028년 이후 건자재·마감재 매출로 이어져요. 착공 32만 호 전망이 맞으면 2027~2028년 시멘트 출하가 늘어요.","impact":"+"},{"date":"2026-08-18","title":"시멘트 가동률 50%대…설비투자는 친환경 합리화에 집중","url":"https://www.mt.co.kr/article/2026081809584283263","src":"머니투데이","read":"2026년 상반기 공장 가동률이 한일 58.9%, 삼표 52.3%, 성신 50.9%, 아세아(제천) 45.9%까지 떨어졌어요. 업계는 2026년 출하를 3,850만~3,900만 톤(2025년 3,810만 톤, 34년 최저와 비슷)으로 보고 반등은 2027년 하반기로 예상해요. 상반기 영업이익은 아세아 350억원(-30.8%), 삼표 217억원(-28.9%)이에요. 설비투자 4,297억원 중 89.5%가 순환연료(폐합성수지) 같은 친환경 합리화라, 물량이 회복되면 원가가 낮아진 상태로 이익이 빠르게 늘 수 있어요.","impact":"-"},{"date":"2026-02-27","title":"시멘트 내수 3,810만 톤, 34년 만에 최저","url":"https://biz.newdaily.co.kr/site/data/html/2026/02/26/2026022600168.html","src":"뉴데일리","read":"2025년 시멘트 내수가 3,810만 톤(-12.8%)으로 1991년 이후 최저였어요. 한일시멘트 2025년 영업이익은 1,318억원(-51.4%)으로 반 토막이 났고, 레미콘 업체 동양은 매출 6,306억원에 영업손실 206억원이었어요. 시멘트는 착공 뒤 골조 공사 때 쓰이므로 2026~2027년 착공이 늘어야 출하가 살아나요.","impact":"-"}]}},"restated":false}