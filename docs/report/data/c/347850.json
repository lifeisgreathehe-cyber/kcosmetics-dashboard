i":{},"biz_src":[],"shocks":[],"peers":[{"code":"347850","name":"디앤디파마텍","self":true,"mcap":1938961,"fy":"2025","equity":79490,"rev":4300,"op":-33990,"ni":-23550},{"code":"196170","name":"알테오젠","group":"플랫폼·기술수출","mcap":9506228,"fy":"2025","rev":215860,"op":106900,"ni":141670,"equity":445190},{"code":"000250","name":"삼천당제약","group":"플랫폼·기술수출","mcap":4248128,"fy":"2025","rev":231810,"op":8470,"ni":5260,"equity":276020},{"code":"009420","name":"한올바이오파마","group":"플랫폼·기술수출","mcap":2967241,"fy":"2025","rev":155180,"op":-920,"ni":-5560,"equity":161680},{"code":"310210","name":"보로노이","group":"플랫폼·기술수출","mcap":2728143,"fy":"2025","rev":7510,"op":-54380,"ni":-42710,"equity":103800},{"code":"141080","name":"리가켐바이오","group":"플랫폼·기술수출","mcap":2443277,"fy":"2025","rev":141550,"op":-106490,"ni":-91550,"equity":507610},{"code":"298380","name":"에이비엘바이오","group":"플랫폼·기술수출","mcap":2429905,"fy":"2025","rev":79350,"op":-40390,"ni":-37810,"equity":154720},{"code":"226950","name":"올릭스","group":"플랫폼·기술수출","mcap":2220971,"fy":"2025","rev":14670,"op":-29970,"ni":-15740,"equity":149380},{"code":"087010","name":"펩트론","group":"플랫폼·기술수출","mcap":2149887,"fy":"2025","rev":5630,"op":-21260,"ni":-13820,"equity":142010}],"manual":{},"src":{"deep":{"products":"오랄링크(경구 펩타이드), DD01(MASH), 경구 비만약(화이자·멧세라)","competition":"노보 노디스크(경구 세마글루타이드), 릴리(오르포글리프론, 저분자).","customers":"화이자(멧세라), 잠재 빅파마.","sourcing":"펩타이드 원료.","moat":{"sources":["경구 펩타이드 특허"],"reason":"경구화 기술은 경쟁이 많지만 빅파마 파트너가 있어요."},"outlook":{"summary":"기술수출 기대.","upside":["DD01 기술수출"],"risks":["경구 저분자 비만약 경쟁"]},"explain":{"title":"먹는 펩타이드 플랫폼, MASH 신약 DD01·멧세라(화이자 인수) 파트너","sections":[{"h":"기술수출(라이선스 아웃) 계약은 어떻게 돈이 되나요?","p":"국내 바이오텍은 신약 후보물질이나 기술(플랫폼)을 빅파마에 넘기고 ① 계약금(업프론트, 보통 총액의 3~10%), ② 개발·허가·매출 단계마다 받는 마일스톤, ③ 출시 후 매출의 일정 비율 로열티(보통 2~15%)를 받아요. 발표되는 '총 계약 규모 3조원'은 모든 단계가 성공했을 때의 최대치라, 실제로는 계약금만 확정이고 나머지는 임상 성공 확률을 곱해서 봐야 해요. 빅파마가 우선순위를 바꿔 권리를 반환하는 일도 흔해요."},{"h":"플랫폼 기술이란?","p":"약 하나가 아니라 여러 약에 반복해서 쓸 수 있는 기술이에요. 정맥주사를 피하주사로 바꾸는 효소(알테오젠 ALT-B4), 항체에 독성 약물을 붙이는 ADC 링커(리가켐), 약을 뇌혈관장벽(BBB) 너머로 보내는 셔틀(에이비엘 그랩바디-B), 약효를 한 달 이상 늘리는 장기지속형 주사(펩트론·인벤티지랩), 먹는 펩타이드(디앤디파마텍) 등이 있어요. 플랫폼 회사는 한 번 검증되면 계약을 여러 건 맺을 수 있어 가치가 커지지만, 첫 검증(임상 데이터·대형 계약) 전에는 기대만으로 주가가 움직여요."},{"h":"임상 단계별 성공 확률","p":"미국 바이오협회(BIO) 통계로 임상 1상에 들어간 약이 허가까지 갈 확률은 평균 약 8%예요. 단계별로는 1상 → 2상 약 52%, 2상 → 3상 약 29%, 3상 → 허가 신청 약 58%, 허가 신청 → 승인 약 90%예요. 항암제는 평균보다 낮고(1상 기준 약 5%), 희귀질환·혈액질환은 높아요. 그래서 2상 약물의 '출시까지 확률'은 대략 15~25%로 봐야 해요. 이 대시보드의 rNPV는 이 확률을 기본으로 회사·적응증별로 조정했어요."},{"h":"디앤디파마텍은 무엇을 하나요?","p":"주사로만 맞던 펩타이드(GLP-1 같은)를 먹는 약으로 바꾸는 '오랄링크' 기술과, 지방간염(MASH) 신약 'DD01'(GLP-1/글루카곤 이중작용)을 가졌어요. 비만 경구약 후보를 미국 멧세라에 넘겼는데, 2025년 화이자가 멧세라를 인수해 파트너가 빅파마가 됐어요. 2026년 6월 MASH 2상에서 3개 지표를 모두 달성했다고 발표했어요."}]},"diagnosis":{"verdict":"투자기","summary":"최근 4개 분기 영업손실 450억원이에요. 임상 비용으로 인한 계획된 적자이고 현금 약 1,500억원이 있어요.","cycle":["임상 비용"],"structural":["경구 펩타이드 기술","화이자 파트너"],"check":["DD01 기술수출","화이자 경구 비만약 임상"]}},"ctx":{"facts":{},"related":[{"name":"화이자","rel":"customer","ind":null,"code":null},{"name":"노보 노디스크","rel":"competitor","ind":null,"code":null},{"name":"알테오젠","rel":"competitor","ind":"bio","code":"196170","peer":true},{"name":"리가켐바이오","rel":"competitor","ind":"bio","code":"141080","peer":true},{"name":"에이비엘바이오","rel":"competitor","ind":"bio","code":"298380","peer":true}],"check":{"verdict":["경쟁력 우위 신호","업종 분위기는 좋지 않은데 회사 뉴스는 긍정적이에요. 업황보다 회사 고유 경쟁력이 작동하는 신호예요."],"notes":["고객사 뉴스 3건이 중립 쪽이에요. 고객 업황은 보통 1~2분기 뒤 이 회사 주문에 반영돼요.","뉴스 언급량이 직전 같은 기간보다 307% 늘었어요. 시장의 관심이 빠르게 커지는 중이에요."]},"signals":[{"date":"2026-11-27","title":"펩트론, 글로벌 빅파마 페링과 '장기지속형 약물전달 플랫폼' 기술평가 계약…\"사업화도 협력\"","url":"https://news.google.com/rss/articles/CBMickFVX3lxTE5KTXFRcnFMZ0FnUGl5Z1RKa1h1WmZ2Yzl0Qy1oT0hHMHFhdFA1WlVmY0VwdlE2ZnVtR215TlRhcDMzaUlRZ0hVdEY4NEtxWWg4b1REWHRCcENVRDdJNjhzSDV0MGg2VGlFVzJZRFMwYmhfUQ?oc=5","office":"프라임경제","rel":"industry","cat":"export","sec":"cycle","tone":"0","who":"플랫폼·기술수출","r":8},{"date":"2026-11-27","title":"[한국증시 전일자 수급] 기관·투신·연기금·외국인 순매수 TOP 10 - 2026년 11월 26일 기준"