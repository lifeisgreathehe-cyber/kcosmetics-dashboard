4.9],["2024Q2",4.5],["2024Q3",1.4],["2024Q4",2.1],["2025Q1",6.3],["2025Q2",9.6],["2025Q3",8.3],["2025Q4",6.5],["2026Q1",8.2],["2026Q2",16.7]]}],"peers":[{"code":"005950","name":"이수화학","self":true,"mcap":217459,"fy":"2025","equity":206252,"rev":1659477,"op":6884,"ni":-31074},{"code":"120110","name":"코오롱인더","group":"정밀·스페셜티","mcap":1087045,"fy":"2025","rev":4873399,"op":108896,"ni":38286,"equity":4219071},{"code":"004000","name":"롯데정밀화학","group":"정밀·스페셜티","mcap":787013,"fy":"2025","rev":1752683,"op":74361,"ni":106093,"equity":2565927},{"code":"298050","name":"효성첨단소재","group":"정밀·스페셜티","mcap":748177,"fy":"2025","rev":3283045,"op":157433,"ni":-21639,"equity":827733},{"code":"268280","name":"미원에스씨","group":"정밀·스페셜티","mcap":629888,"fy":"2025","rev":532123,"op":65482,"ni":61303,"equity":483466},{"code":"006380","name":"카프로","group":"정밀·스페셜티","mcap":618529,"fy":"2025","rev":24638,"op":-21120,"ni":-32360,"equity":63404},{"code":"069260","name":"TKG휴켐스","group":"정밀·스페셜티","mcap":420179,"fy":"2025","rev":1127691,"op":65615,"ni":59907,"equity":796893},{"code":"161000","name":"애경케미칼","group":"정밀·스페셜티","mcap":419166,"fy":"2025","rev":1452335,"op":-10193,"ni":-2949,"equity":715478},{"code":"014830","name":"유니드","group":"정밀·스페셜티","mcap":337293,"fy":"2025","rev":1338758,"op":87909,"ni":65259,"equity":1148601}],"manual":{},"src":{"deep":{"products":"LAB, 노말파라핀, IPA 등 정밀화학, 건설 자회사예요.","competition":"LAB는 중동(사우디·카타르), 인도, 중국 업체와 아시아 시장에서 경쟁해요.","customers":"LG생활건강·애경산업 등 세제 업체와 해외 계면활성제 업체가 고객이에요.","sourcing":"등유(정유사)와 벤젠을 사서 써요.","moat":{"sources":["국내 유일 생산","물류 근접성"],"reason":"국내·동북아 고객에 가까운 유일한 생산자라 운임 우위가 있지만, 범용 제품이라 해자는 좁아요."},"outlook":{"summary":"중동 차질로 2027년 계약 여건이 좋아요. 다만 일시 수혜 성격이라 정상화 이익은 보수적으로 봐야 해요.","upside":["2027년 계약 마진 상승","IPA 반도체용 확대"],"risks":["중동 정상화","건설 자회사 손실","원료가 급등"]},"explain":{"title":"이수화학: 세탁세제 원료 LAB 국내 유일 생산자, 노말파라핀·용제","sections":[{"h":"LAB란?","p":"선형 알킬벤젠(LAB)은 세탁세제의 주성분인 계면활성제(LAS)의 원료예요. 등유에서 노말파라핀을 뽑아 벤젠과 붙여 만들어요. 생필품 원료라 수요는 경기와 거의 무관하게 꾸준하고, 판가는 등유·벤젠 가격에 마진을 얹는 구조예요."},{"h":"노말파라핀·기타","p":"노말파라핀(NP)은 LAB 원료이자 염화파라핀·용제로도 팔아요. 그 밖에 IPA(이소프로필알코올, 반도체 세정용 고순도 포함) 등 정밀화학 제품도 있어요."},{"h":"자회사 부담","p":"과거 이수건설 등 건설 자회사 부실이 연결 실적을 자주 깎아 먹었어요. 화학 본업과 자회사 위험을 나눠 보는 게 중요해요."}]},"diagnosis":{"verdict":"본업은 수급 개선(중동 차질 수혜)","summary":"LAB는 중동 업체 비중이 큰데, 중동 전쟁 장기화로 공급 차질이 생기면서 아시아 수요처가 대체 공급원을 찾고 있어요. 국내 유일 LAB 생산자인 이수화학이 2027년 연간 계약에서 가격·물량 모두 유리한 위치예요. 이건 외부 충격에 따른 일시적(사이클) 수혜라 영원하지 않다는 점을 감안해야 해요. 3분기 실적은 11월 14일 전후 공시 예정이라, 발표 후 진단을 갱신할게요.","cycle":["중동 LAB 공급 차질","등유·벤젠 원료 가격"],"structural":["국내 유일 생산, 아시아 고객 기반","건설 자회사 리스크는 구조적 할인 요인이에요."],"check":["2027년 LAB 연간 계약 가격","중동 정세 정상화 시점","건설 자회사 손실"]}},"ctx":{"facts":{"report":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001474","date":"20261116","overview":["차입관련 SPC는 사업부문 구분에 포함하지 아니하였습니다.","당사는 1969년 1월 17일에 설립되어 주로 합성세제원료와 그 부산물의 제조, 가공 및 판매업을 주요 영업으로 하고 있으며, 당분기말 현재 울산 및 온산에 공장을 두고 있습니다.","글로벌업체들과 장기계약 체결을 통한 안정적인 판매물량 확보 등을 바탕으로 2026년 3분기 매출액(사업부문간 매출액 제외 기준)은 전년동기 대비 약 80% 증가한 약 1조 7,882억원을 달성하였고, 연결기준 매출액의 약 86.7%를 차지하고 있습니다."],"products":["건설사업부문은 주요제품 가격변동추이 산출이 불가하여 기재를 생략하였습니다."],"materials":["(주2) 의약사업부문의 가동률을 계산할 수 있는 제품은 클로티냅, 애브서틴, 파바갈 세 개의 제품이며 그 외 매출에 기여하고 있는 사업부문은 제외하였습니다.","건설사업부문은 생산능력수량 산출이 불가하여 기재를 생략하였습니다."],"channel":["1) 본사 ① 석유화학 부문: 영업본부장 이하 본사영업팀, 독일법인, 멕시코사무소로 구성되어 있습니다.","수출의 경우 직수출 또는 트레이딩 업체를 통한 판매를 진행하고 있으며, 내수/로컬은 직판체제를 갖추고 있습니다."],"share":["지역별 매출 전망 이미지1.jpg 참고자료2 3) 치료 분야별 점유율 □ 글로벌 의약품 치료 분야별 기준, 종양학(Oncology)분야가 시장 성장 견인 - 종양학 분야는 19% (2025년)의 가장 높은 매출 비중을 차지하고, 2032년에는 20% 까지 점유율이 상승할 것으로 전망됩니다.","치료 분야별 점유율 이미지1.jpg 참고자료3 4) 바이오의약품 시장 전망 □ 바이오의약품 시장은 10년간 연평균 9.8%의 증가세를 나타내며 2025년 4,870억 달러에서 2035년 1조 2430억 달러까지 성장할 것으로 전망됩니다."],"competition":["전 세계에 독점적으로 특허를 보유한 업체가 개발한 바이오의약품은 독점적 시장의 지위를 특허 만료 시점까지는 유지할 것으로 전망되나, 특허 만료 이후 또는 특허 자유 지역에서는 바이오시밀러가 개발되어 점차 독점적 시장 지위 유지가 어려울 것으로 판단됩니다.","다만 바이오시밀러개발과정이 신약에 준하는 임상 과정을 요구하는 등 진입장벽이 상당히 존재하고 있어 완전경쟁시장보다는 점차적으로 과점적 성격의 시장을 형성할 것으로 전망됩니다."],"industry":["1980년도에 합성세제 원료인 연성알킬벤젠 공장을 준공한 이래 국내 유일 생산으로 안정적 입지를 보유하고 있습니다.","1990년도에 연성알킬벤젠 원료 자급화와 경쟁력 강화 목적으로 노말파라핀 공장을 준공한 후 내수와 수출을 병행하는 전략으로 폭넓은 시장을 형성하여 왔습니다.","현재 전 세계적인 생활 수준의 향상으로 인한 세탁세제의 보급 증대로 연성알킬벤젠(LAB)과 노말파라핀(NP) 시장이 점진적으로 성장하고 있습니다."],"cyclical":["참고자료6.jpg 참고자료6 라. 경기변동의 특성 당사가 주력하고 있는 바이오의약품 시장은 일반 제약의 경기 변동과 동일하다고 볼 수 있으므로 아래의 각 항목에서는 제약시장에 대하여 서술하겠습니다.","① 일반 경기 변동과의 관계일반적으로 제약산업은 경기 변동성이 가장 낮은 사업 중의 하나입니다."]},"related":[{"name":"LG생활건강","rel":"customer","ind":"cosmetics","code":"051900"},{"name":"애경산업","rel":"customer","ind":"cosmetics","code":"018250"},{"name":"롯데정밀화학","rel":"competitor","ind":"chem","code":"004000","peer":true},{"name":"코오롱인더","rel":"competitor","ind":"chem","code":"120110","peer":true},{"name":"효성첨단소재","rel":"competitor","ind":"chem","code":"298050","peer":true},{"name":"SKC","rel":"competitor","ind":"chem","code":"011790","peer":true}],"check":{"verdict":["업황 순풍","회사와 업종 뉴스가 함께 긍정적이에요. 실적 개선의 상당 부분이 업황(사이클) 덕분일 수 있어, 정점 신호도 같이 지켜보세요."],"notes":["고객사 뉴스 4건이 긍정 쪽이에요. 고객 업황은 보통 1~2분기 뒤 이 회사 주문에 반영돼요."]},"signals":[{"date":"2026-11-27","title":"[경제계 인사]HS효성 사장 안성훈, HS효성첨단소재 사장 성낙양","url":"https://n.news.naver.com/mnews/article/020/0003765547","office":"동아일보","rel":"competitor","who":"효성첨단소재","cat":null,"sec":"competition","tone":"0","r":11},{"date":"2026-11-27","title":"폴리클로로트리플루오로에틸렌(PCTFE) 수지 시장 2035년 전망: 반도체 수요가 성장 견인 - 뉴스 및 통계","url":"https://news.google.?oc=5","office":"IndexBox","rel":"industry","cat":null,"sec":"cycle","tone":"+","who":"정밀·스페셜티","r":12},{"date":"2026-11-26","title":"LG생활건강, SNS 인기 세제 향기 담은 섬유유연제·탈취제 출시","url":"https://n.news.naver.com/mnews/article/022/0004178367","office":"세계일보","rel":"customer","who":"LG생활건강","cat":"launch","sec":"customers","tone":"+","r":33},{"date":"2026-11-26","title":"대만서 통한 탈모케어…애경산업 블랙포레, 건강미용대상 수상","url":"https://n.news.naver.com/mnews/article/421/0009311041","office":"뉴스1","rel":"customer","who":"애경산업","cat":"export","sec":"customers","tone":"+","r":2},{"date":"2026-11-26","title":