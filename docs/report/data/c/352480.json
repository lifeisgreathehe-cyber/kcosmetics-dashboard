:"raw/ir_text/352480_2025-12-03_71630.txt","kb":3248,"pages":15},{"id":"71392","kind":"IR자료","date":"2025-11-20","title":"씨앤씨인터내셔널, 회사소개 및 사업현황 설명","page":"https://m.irgo.co.kr/IR자료/71392/TB/씨앤씨인터내셔널-씨앤씨인터내셔널-회사소개-및-사업현황-설명","file":"[A352480]씨앤씨인터내셔널_20251120.pdf"}],"biz":[],"biz_kpi":{},"biz_src":[{"nm":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001238"},{"nm":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000807"}],"shocks":[{"start":"2021Q3","start_gpm":16.6,"trough":"2021Q4","trough_gpm":9.8,"drop":6.8,"recovered":"2022Q1","quarters":2,"path":[["2021Q3",16.6],["2021Q4",9.8],["2022Q1",18.2]]},{"start":"2022Q3","start_gpm":27.9,"trough":"2022Q4","trough_gpm":20.0,"drop":7.9,"recovered":null,"quarters":null,"path":[["2022Q3",27.9],["2022Q4",20.0],["2023Q1",22.7],["2023Q2",23.2],["2023Q3",20.2],["2023Q4",22.2],["2024Q1",19.1],["2024Q2",19.9],["2024Q3",16.0],["2024Q4",7.6],["2025Q1",15.2],["2025Q2",18.2],["2025Q3",15.6],["2025Q4",9.0],["2026Q1",12.2],["2026Q2",10.6],["2026Q3",8.4]]}],"peers":[{"code":"352480","name":"씨앤씨인터내셔널","self":true,"mcap":257786,"fy":"2025","equity":337097,"rev":288478,"op":22171,"ni":14287},{"code":"192820","name":"코스맥스","group":"ODM·OEM","mcap":3576725,"fy":"2025","rev":2398758,"op":195792,"ni":123064,"equity":638522},{"code":"161890","name":"한국콜마","group":"ODM·OEM","mcap":3054518,"fy":"2025","rev":2722419,"op":239595,"ni":125079,"equity":1041113},{"code":"241710","name":"코스메카코리아","group":"ODM·OEM","mcap":1291212,"fy":"2025","rev":640929,"op":83537,"ni":45440,"equity":274689},{"code":"024720","name":"콜마홀딩스","group":"ODM·OEM","mcap":326128,"fy":"2025","rev":630112,"op":47743,"ni":23435,"equity":672978},{"code":"003350","name":"한국화장품제조","group":"ODM·OEM","mcap":321734,"fy":"2025","rev":184628,"op":32884,"ni":27373,"equity":137863},{"code":"044820","name":"코스맥스비티아이","group":"ODM·OEM","mcap":236048,"fy":"2025","rev":645206,"op":26984,"ni":29208,"equity":321882},{"code":"950140","name":"잉글우드랩","group":"ODM·OEM","mcap":136318,"fy":"2025","rev":216144,"op":36972,"ni":24174,"equity":178350}],"manual":{},"cons_hist":[],"tp_mentions":[],"src":{"deep":{"products":"색조 화장품 전문 ODM으로 100% 자체 기획(ODM) 방식만 해요. 2025년 매출 2,885억원 중 입술(립틴트·립스틱) 64%, 베이스 21%, 눈(아이라이너·펜슬) 14%예요. 국내 립틴트 시장에서 대부분의 브랜드가 이 회사 제품을 공급받는 '립 강자'예요.","competition":"공식 점유율은 없지만 국내 립틴트 ODM 1위로 평가돼요. 색조 전반에선 코스맥스·인터코스·코스메카코리아와 경쟁하고, 중국 현지 ODM의 저가 공세도 있어요.","customers":"N사·M사·R사 등 이니셜로 공시해요. 롬앤·클리오·페리페라 등 국내 인디 색조와 미국 인디 뷰티가 핵심이에요. 2025년 미주 수출이 881억원으로 커졌고, 상해 법인이 중국 고객을 맡아요.","sourcing":"상반기 매입 795억원 중 부재료(용기·캡·단상자, 대동 등)가 79%, 원료(오일·착색제·계면활성제, 우진트레이딩 등)가 21%예요. 수입 착색제 단가 변동이 커요. 본사·용인 그린카운티·상해 공장 생산능력은 연 3억 4,900만 개예요.","moat":{"sources":["립 처방 노하우","고객 관계"],"reason":"립틴트 처방과 빠른 제안 능력으로 국내 브랜드 대부분을 고객으로 확보했지만, 색조는 트렌드에 따라 수요가 크게 출렁이고 경쟁 ODM이 같은 제품을 만들 수 있어요."},"outlook":{"summary":"매출은 버티지만 이익률이 무너진 상태예요. 3~4년 기준 시나리오는 매출 연 5~8% 성장, 영업이익률 6~9% 회복이에요. 미국 인디 고객의 재고 조정이 끝나고 베이스 제품이 커지는지가 관건이에요.","upside":["미주 고객 주문 회복","베이스 제품 확대","중국 법인 성장"],"risks":["립 트렌드 둔화","가격 경쟁","가동률 하락"]},"explain":{"title":"","sections":[{"h":"립틴트 제조 기술","p":"틴트는 색소가 입술 각질에 스며들어 착색되는 제품이에요. 발색(처음 색), 착색(지워도 남는 색), 지속력, 건조감, 묻어남 정도를 원료 배합으로 조절해요. 씨앤씨는 이 '질감 조합'을 수백 가지로 설계해 브랜드에 먼저 제안하는 방식으로 국내 틴트 대부분을 공급해요."},{"h":"펜슬·베이스","p":"아이라이너·아이브로 펜슬은 심 성형·깎기 기술이 필요하고 특허도 보유해요. 최근엔 쿠션·파운데이션 같은 베이스 제품을 늘리고 있어요."},{"h":"돈 버는 구조","p":"매입의 79%가 용기·캡 등 부재료예요. 제품 단가가 개당 1,500~2,000원으로 낮아, 가동률이 떨어지거나 부재료 값이 오르면 이익이 급감해요."}]},"diagnosis":{"verdict":"사이클+구조 혼재","summary":"이익률 급락은 립 트렌드 둔화와 미국 고객사 재고 조정(사이클)이 크지만, 색조 ODM 간 가격 경쟁과 중국 저가 ODM 공세(구조)도 겹쳤어요. 입술 제품 매출이 1,936억원(2024)→1,834억원(2025)으로 줄었지만 베이스 제품은 418억원→600억원으로 늘어 다변화는 진행 중이에요.","cycle":null,"structural":null,"check":null}},"ctx":{"facts":{"report":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000807","date":"20261116","overview":["당사는 색조화장품을 전문적으로 개발하고 생산하는 색조화장품 전문 ODM 기업입니다.","제조업자 개발생산을 뜻하는 ODM(Original Development & Design Manufacturing) 시스템은 제조업체가 보유하고 있는 독자적인 기술력과 노하우를 바탕으로 상품기획부터 개발, 생산, 품질관리 및 출하에 이르기까지 전 과정에 대한 토탈 서비스를 실현하는 방식입니다.","일반적인 화장품 제조업체는 ODM 방식과 OEM 방식을 함께 운영하고 있으나, 당사는 영업 특성상 자체 기획을 원칙으로 하고 있기 때문에 100% ODM 방식만을 운영하고 있습니다."],"channel":["당사는 색조화장품 ODM 전문업체로 당사가 직접적으로 소비자에게 제품을 판매하지 않고, 당사의 주요 매출처인 브랜드사에 제품을 납품하면 해당 브랜드사에서 최종적으로 소비자에게 제품을 판매합니다.","따라서, 당사의 제품은 기본적으로 100% B2B 방식에 따라 판매됩니다."],"strategy":["ODM 영업의 패션 부띠끄化대부분의 ODM사들이 연구소에서 개발한 신제품을 브랜드 고객사에 제안하는 방식의 영업 형태를 취하고 있지만, 당사는 한발 더 나아가서 각 브랜드의 컨셉에 맞는, 그리고 각 브랜드 내의 특정 제품의 후속 출시에 걸맞은 제품을 고객보다 먼저 기획, 개발해오고 있습니다."],"customers":["연결회사의 주요 매출처는 매출 비중의 3순위 안에 드는 기업으로 국내 및 북미 소재 고객사이며, 비중은 전체 매출액 대비 약 25% 수준입니다."],"orders":["당사가 영위하는 ODM 비즈니스는 수주를 기반으로 하는 산업이 아니며, 산업의 특성상 양사 간 거래 조건 설정을 위한 간단한 계약서만을 작성하고, 발주물량에 대한 계약은 별도 작성하지 않습니다."],"industry":["주요 목표시장당사는 색조 전문 ODM 업체이며, 당사가 목표로 하는 전방시장은 당사가 제품을 공급하는 브랜드사가 속한 화장품 시장에 해당합니다.","① 인디 뷰티 브랜드의 성장과 글로벌 트렌드화 대규모 화장품 브랜드를 중심으로 형성되어 있던 기존 화장품 시장은 중소 인디 뷰티 브랜드 중심으로 시장 구조가 재편되고 있습니다.","이러한 디지털 기반 마케팅 방식은 잠재 고객층인 10~20대 소비자에게 효과적으로 도달하며, 한국 시장에 국한되지 않고 전 세계적으로 인디 뷰티 브랜드의 성장을 가속화하고 있습니다."]},"related":[{"name":"클리오","rel":"customer","ind":"cosmetics","code":"237880"},{"name":"우진","rel":"supplier","ind":"energy","code":"105840"},{"name":"코스메카코리아","rel":"competitor","ind":"cosmetics","code":"241710"},{"name":"코스맥스","rel":"competitor","ind":"cosmetics","code":"192820"},{"name":"한국콜마","rel":"competitor","ind":"cosmetics","code":"161890","peer":true},{"name":"콜마홀딩스","rel":"competitor","ind":"cosmetics","code":"024720","peer":true}],"check":{"verdict":["경쟁력 점검 필요","업종이나 경쟁사 뉴스는 나쁘지 않은데 회사 뉴스만 부정적이에요. 점유율·제품 경쟁력이 약해지는지 확인이 필요해요."],"notes":["뉴스 언급량이 직전 같은 기간보다 200% 늘었어요. 시장의 관심이 빠르게 커지는 중이에요."]},"signals":[{"date":"2026-11-27","title":"코스맥스, 부자재 공급망 강화 나선다…K뷰티 수요 확대 대비","url":"https://n.news.naver.com/mnews/article/030/0003490627","office":"전자신문","rel":"competitor","who":"코스맥스","cat":"input","sec":"competition","tone":"0","r":11},{"date":"2026-11-27","title":"코스맥스, 월 생산량 1억 개 돌파 ‘K-뷰티 공급망 강화’ 본격화","url":"https: