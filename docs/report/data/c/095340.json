ity":205462},{"code":"080580","name":"오킨스전자","group":"테스트 부품","mcap":284500,"fy":"2025","rev":94374,"op":11086,"ni":7744,"equity":76612},{"code":"098120","name":"마이크로컨텍솔","group":"테스트 부품","mcap":268900,"fy":"2025","rev":100314,"op":17745,"ni":16886,"equity":103798},{"code":"172670","name":"에이엘티","group":"테스트 부품","mcap":59915,"fy":"2025","rev":48358,"op":-7395,"ni":-8966,"equity":91239},{"code":"049080","name":"기가레인","group":"테스트 부품","mcap":47941,"fy":"2025","rev":40331,"op":-12476,"ni":-10599,"equity":33686},{"code":"147760","name":"피엠티","group":"테스트 부품","mcap":46800,"fy":"2025","rev":25288,"op":-20396,"ni":-22477,"equity":46249}],"manual":{},"cons_hist":[["2026-11-28",{"cy":{"y":2026,"rev":3104.0,"op":1004.0},"nq":{"q":"2026Q3","rev":824.0,"op":275.0},"tp":214286.0,"rec":4.0,"price":116800.0}]],"tp_mentions":[{"date":"2026-05-26","broker":null,"tp":300000.0,"title":"HPSP 24% 급등·ISC 목표가 30만원…AI 반도체주 들썩 [칩칩폭폭]","url":"https://n.news.naver.com/mnews/article/123/0002383625"},{"date":"2026-02-10","broker":null,"tp":220000.0,"title":"\"ISC, 선제적 투자 수혜 극대화할 것…목표가 22만원\"-한투","url":"https://n.news.naver.com/mnews/article/008/0005316310"},{"date":"2025-11-26","broker":"하나證","tp":130000.0,"title":"하나證 “ISC, 4분기에도 이익 성장 전망… 목표가 13만원”","url":"https://n.news.naver.com/mnews/article/366/0001125905"}],"src":{"deep":{"products":"실리콘 러버 테스트 소켓과 번인 소켓을 만들어요.","competition":"러버 소켓 세계 1위이고 포고 소켓 업체(리노공업 등)와 간접 경쟁해요.","customers":"세계 칩 회사와 테스트 업체, AI 가속기 고객이에요.","sourcing":"실리콘·금속 소재를 사요.","moat":{"sources":["점유율 1위","고객 인증"],"reason":"러버 소켓은 품질 인증이 필요해 고객이 쉽게 바꾸지 않아요."},"outlook":{"summary":"AI 가속기 테스트 수요로 2027년까지 성장이 예상돼요. 주가는 이익의 45배예요.","upside":["AI 칩 고객 확대"],"risks":["테스트 방식 변화"]},"explain":{"title":"실리콘 러버 테스트 소켓","sections":[{"h":"러버 소켓은 무엇인가요?","p":"칩을 테스트할 때 칩 단자와 보드를 잇는 소켓 중, 실리콘 고무 안에 도전성 금속 가루를 세로 기둥 모양으로 박아 넣은 방식이에요. 누르면 기둥이 압축되며 전기가 통해요. 스프링 핀보다 전기 경로가 짧아 고속 신호 손실이 적고, 칩 단자를 덜 손상시켜요."},{"h":"AI 칩에서 강한 이유","p":"AI 가속기는 단자 수가 수천~수만 개이고 칩이 크며 고속 신호를 써요. 러버 소켓은 단자 간격이 좁고 수가 많은 칩에 유리해 AI·서버용 칩 테스트에서 채택이 늘었어요. ISC는 러버 소켓 세계 1위이고, 2023년 SKC 계열로 편입된 뒤 북미 AI 고객을 넓혔어요."},{"h":"돈을 버는 구조","p":"소켓은 일정 횟수 쓰면 바꾸는 소모품이라 고객 칩 생산이 늘면 반복 매출이 나와요. 고객 맞춤 제작이라 이익률이 높고(최근 영업이익률 30%대), 번인 소켓(고온 신뢰성 시험용)도 함께 팔아요."}]},"diagnosis":{"verdict":"구조적 성장","summary":"매출이 2023년 1,402억원(영업이익 107억원)에서 2025년 2,201억원(600억원)으로 늘었고, 2026년 상반기 영업이익률이 32%예요. 2023년 부진은 업황 사이클이었고, 이후 AI 칩 고객 확대로 사업 구조가 좋아졌어요.","cycle":["2023년 반도체 재고 조정으로 소켓 수요가 줄었어요."],"structural":["AI 가속기 테스트용 러버 소켓 수요가 구조적으로 늘고 있어요.","SKC 편입 후 북미 고객 확대가 성과를 냈어요.","AI 고객 몇 곳에 매출이 몰려 고객 집중 위험이 있어요."],"check":["북미 AI 고객 매출 비중","영업이익률 30% 유지","신규 AI 칩 소켓 수주"]}},"ctx":{"facts":{"report":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000017","date":"20261116","overview":["당사는 본사인 ISC를 거점으로 총 4개의 생산 및 판매법인으로 구성된 글로벌 반도체 테스트 부품 기업입니다.","당사의 주력사업은 반도체 칩을 테스트하는 반도체 테스트 소켓입니다.","또한 반도체 테스트 장비와 공정에 필요한 부품을 공급하는 반도체 테스트 장비와 공정에 필요한 부품을 공급하는 장비/소재 사업을 병행하고 있습니다 당사는 제품 생산을 위한 전체 공정을 내재화해 다품종, 단납기라는 반도체 테스트 소켓 시장의 특성에 맞게 안정적인 품질과 신속한 납기를 위한 생산기술로 경쟁 우위를 확보하고 있습니다."],"products":["가격 추이 통상 당사 제품은 출시 당시 가장 높은 부가가치를 형성하며 시간이 지날 수록 가격이 하락하는 양상을 보입니다.","그러나 매출의 대부분이 주문 제작 제품으로 고객사별 공급 수량 및 제품의 스펙에 따라 적정가격을 책정하므로 가격 하락에 대한 리스크는 작습니다."],"mix":[{"label":"iSC 등","pct":82.1}],"materials":["공시대상 기간 중에 해당 사업부문의 수익성에 중요한 영향을 미치는 원재료의 가격 변동은 없었으나 국제 금 시세 및 공급업체의 제작 단가 변동 등의 요인이 단가 변동에 영향을 줄 수 있습니다."],"channel":["당사의 판매조직은 국내 영업실과 해외 영업실로 구성되어 있습니다.","당사의 판매경로는 국내 영업실과 해외 영업실로 구분됩니다."],"share":["엘라스토머 소켓(실리콘 러버 소켓)은 ISC 매출의 80%를 차지하며 글로벌 엘라스토머 소켓(실리콘 러버 소켓) 시장에서 ISC의 점유율은 90% 수준으로 평가받고 있습니다.","지난 2015년 이후 반도체 테스트소켓 세계 시장점유율 1위를 유지하고 있으며 메모리 반도체와 비메모리 반도체용 소켓 모두 생산하고 있습니다."],"competition":["당사는 엘라스토머(실리콘)을 기반으로 하는 반도체 테스트 소켓을 국내 최초로 개발, 세계 최초로 양산화에 성공했습니다.","지난 2015년 이후 반도체 테스트소켓 세계 시장점유율 1위를 유지하고 있으며 메모리 반도체와 비메모리 반도체용 소켓 모두 생산하고 있습니다."],"industry":["패키징 테스트공정의 주요 부품으로는 번인 테스트에 사용하는 번인 소켓, 패키징 테스트에 사용하는 테스트 소켓 (엘라스토머(실리콘) 러버소켓, 포고 소켓), 테스트 솔루션 (Thermal Solution,테스트장비)가 있으며 ISC는 Total Test Solution 형태로 글로벌 팹리