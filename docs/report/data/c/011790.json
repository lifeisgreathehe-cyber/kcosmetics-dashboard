026Q1",8.4],["2026Q2",10.9],["2026Q3",5.2]]}],"peers":[{"code":"011790","name":"SKC","self":true,"mcap":3151213,"fy":"2025","equity":1569240,"rev":1840036,"op":-305025,"ni":-734388},{"code":"020150","name":"롯데에너지머티리얼즈","group":"동박·알루미늄박","mcap":2204555,"fy":"2025","rev":677531,"op":-145226,"ni":-157547,"equity":1624121},{"code":"006110","name":"삼아알미늄","group":"동박·알루미늄박","mcap":644268,"fy":"2025","rev":271459,"op":-17647,"ni":-24889,"equity":219507},{"code":"336370","name":"솔루스첨단소재","group":"동박·알루미늄박","mcap":437913,"fy":"2025","rev":616083,"op":-73336,"ni":-66862,"equity":646762},{"code":"018470","name":"조일알미늄","group":"동박·알루미늄박","mcap":114886,"fy":"2025","rev":486679,"op":13795,"ni":7976,"equity":223229}],"manual":{},"src":{"deep":{"products":"동박(SK넥실리스), 반도체 글라스기판·테스트 소켓, PO·PG 화학.","competition":"동박은 롯데에너지머티리얼즈·중국 업체, 글라스기판은 인텔·일본 업체예요.","customers":"LG에너지솔루션·SK온·해외 셀 업체, 반도체 고객이에요.","sourcing":"구리, 화학 원료예요.","moat":{"sources":["극박 동박 기술"],"reason":"기술 우위가 있지만 가격 경쟁에 해자가 약해졌어요."},"outlook":{"summary":"동박 가동률 회복과 글라스기판 상용화가 2027년 이후 반등 요인이에요.","upside":["글라스기판 양산","동박 북미 수요"],"risks":["재무 부담"]},"explain":{"title":"동박(SK넥실리스)·반도체 소재·화학","sections":[{"h":"동박·알루미늄박은 무엇인가요?","p":"음극재(흑연)는 얇은 구리 포일(동박) 위에, 양극재는 알루미늄 포일 위에 발라요. 이 포일이 전류를 모아 밖으로 내보내는 집전체예요. 동박은 황산구리 용액에서 전기로 구리를 얇게 석출(전해)해 4~10㎛ 두께로 만들고, 얇고 균일하며 잘 늘어나야(연신율) 고급품이에요. 원가는 구리 가격에 가공비를 더한 구조라 이익은 가공비와 가동률이 결정해요."},{"h":"SKC의 사업","p":"SK그룹 소재 회사로 동박 자회사 SK넥실리스(정읍·말레이시아·폴란드), 반도체 글라스기판(앱솔릭스)·테스트 소켓(ISC), 화학(PO·PG) 사업을 가지고 있어요. 6㎛ 이하 극박·광폭 동박 기술은 세계 최고 수준이에요."},{"h":"돈을 버는 구조","p":"동박은 가동률과 가공비, 반도체 소재는 AI 서버용 유리기판의 상용화 속도가 핵심이에요. 동박 적자와 증설 차입으로 재무 부담이 커졌어요."}]},"diagnosis":{"verdict":"사이클 + 투자 부담","summary":"동박 적자가 2023~25년 이어지며 연결 적자가 커졌어요. 업황 요인이 크지만 대규모 해외 증설이 고정비·차입 부담으로 돌아왔어요.","cycle":["배터리 수요 둔화로 동박 가동률이 떨어졌어요."],"structural":["극박 기술은 강점이지만 중국 가공비 경쟁이 심해요.","글라스기판은 장기 성장 옵션이에요."],"check":["동박 가동률","글라스기판 고객 양산","재무구조 개선"]}},"ctx":{"facts":{"report":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001826","date":"20261116","overview":["SKC는 리튬이온 이차전지 소재인 전지박(Copper Foil) 등 제품을 생산, 판매하는 이차전지 소재사업, PO 등을 생산, 판매하는 화학사업, 반도체테스트용 실리콘러버소켓,테스트 장비 등을 판매하는 반도체 소재/부품 사업 등을 영위하고 있습니다.","이차전지 소재사업의 전지박은 이차전지에서 음극집전체로 작용하는 핵심 소재로서 이차전지 산업과 밀접한 관련이 있으며, 전기차, ESS 및 기타 중소형 IT기기 산업에 적용되는 제품 입니다.","전지박 시장은 크게 사용 용도에 따라 IT기기 및 전동 공구 등에 적용되는 소형 전지 시장과 EV 및 ESS등에 적용되는 중대형 전지 시장으로 분류됩니다."],"products":["주요 제품등의 현황 * POD는 PO 및 PO 유도체인 PG 등을 의미합니다.","전지박 판가는 주요 원재료인 구리값에 가공비를 더하여 결정되고 있습니다."],"materials":["생산설비 가. 원재료 매입액 (*) 에스케이넥실리스는 2024년 11월 13일 이사회 결정에 따라 FCCL 사업을 양도하기로 하였으며, 2025년 4월 30일 거래종료하였습니다.","SK엔펄스는 2024년 12월 24일 이사회 결정에 따라 CMP PAD 사업을 양도하기로 하였으며, 2025년 4월 4일 거래 종료하였습니다."],"channel":["판매 방법 [SK넥실리스]1) 판매조직영업본부는 제품 및 고객에 따라 4개팀으로 구분되어 있습니다.","고객사와의 중장기 계약 체결을 통해 안정적인 공급물량을 확보하는 것과 고객사 다변화 통화 변동성 관리가 중요한 판매전략으로 볼 수 있습니다."],"strategy":["고객사와의 중장기 계약 체결을 통해 안정적인 공급물량을 확보하는 것과 고객사 다변화 통화 변동성 관리가 중요한 판매전략으로 볼 수 있습니다."],"customers":["사 내 점유율 확대 등으로 견조한 흐름을 보일 것으로 전망합니다.","ⓑ 장비/소재사업 캡티브 고객사의 신규 팹 증설에 맞춰 필요한 케미컬, EFEM이 우선 증가하고 팹 완공 후 양산에 앞서 테스터와 메모리 모듈PCB 공급이 늘어날 것으로 예상합니다."],"competition":["전지박 산업은 거대한 자본이 투입되는 대규모 장치 산업이라는 특성 때문에 각 국가마다 소수 업체 위주의 과점체제를 구축하고 있습니다.","국내에서는 당사 외 3개 업체가 사업을 영위하고 있으며, 해외의 경우 일본 및 중국, 대만, 유럽 등에 경쟁업체들이 분포하고 있습니다."],"industry":["② 산업의 성장성 전지박은 이차전지의 핵심 필수소재로서 향후 이차전지 산업 및 전기차, ESS 등 전방산업의 성장과 밀접한 연관이 있습니다.","기존에는 스마트폰, 노트북 등 중소형 IT기기가 이차전지의 주요 전방산업이었으나 최근 이차전지의 기술적 난제였던 고밀도, 고용량, 고출력 및 안정성 등의 문제가 해결되며 단순히 중소형 IT기기를 넘어 ESS, 전동공구, 전기자전거, 그리고 전기차에 이르기까지 그 적용처를 빠르게 확장하고 있습니다.","최근 시장 리포트에 따르면 전기차 시장은 ‘24년 판매량 1,763만대에서 ‘30년까지 연평균 16% 성장한 4,335만대로 전망되며 이러한 전방시장의 중장기적 성장세에 힘입어 전지박 수요도 점진적 성장이 예상됩니다."],"cyclical":["③ 경기 변동의 특성 전지박 산업은 글로벌 환경 규제 및 자동차 산업의 영향을 많이 받습니다 ④ 경쟁요소 전지박 산업은 거대한 자본이 투입되는 대규모 장치 산업이라는 특성 때문에 각 국가마다 소수 업체 위주의 과점체제를 구축하고 있습니다.","③ 경기 변동의 특성 인구 증가 및 삶의 질 향상과 연계된 화장품, 식음료, 향정·향료, 의약품 등 전방산업의 경기 변동에 영향을 받습니다."]},"related":[{"name":"LG에너지솔루션","rel":"customer","ind":"battery","code":"373220"},{"name":"SK온","rel":"customer"