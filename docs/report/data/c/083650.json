.5],["2024Q2",15.0],["2024Q3",13.5],["2024Q4",14.7],["2025Q1",16.8],["2025Q2",17.9],["2025Q3",13.8],["2025Q4",14.8],["2026Q1",16.7],["2026Q2",19.0],["2026Q3",17.7]]}],"peers":[{"code":"083650","name":"비에이치아이","self":true,"mcap":1081397,"fy":"2025","equity":282086,"rev":774117,"op":75497,"ni":65200},{"code":"034020","name":"두산에너빌리티","group":"원자력","mcap":26875565,"fy":"2025","rev":17057876,"op":762712,"ni":84762,"equity":7444784},{"code":"052690","name":"한전기술","group":"원자력","mcap":2392946,"fy":"2025","rev":518768,"op":35453,"ni":85368,"equity":594398},{"code":"051600","name":"한전KPS","group":"원자력","mcap":1545800,"fy":"2025","rev":1576517,"op":140102,"ni":124231,"equity":1364189},{"code":"032820","name":"우리기술","group":"원자력","mcap":1428957,"fy":"2025","rev":87135,"op":-5487,"ni":792,"equity":184794},{"code":"126720","name":"수산인더스트리","group":"원자력","mcap":246814,"fy":"2025","rev":337655,"op":43079,"ni":48904,"equity":570790},{"code":"105840","name":"우진","group":"원자력","mcap":166357,"fy":"2025","rev":150379,"op":14178,"ni":8707,"equity":196767},{"code":"046120","name":"오르비텍","group":"원자력","mcap":91371,"fy":"2025","rev":57909,"op":-14012,"ni":481,"equity":97438},{"code":"011700","name":"한신기계","group":"원자력","mcap":59683,"fy":"2025","rev":52719,"op":-1478,"ni":-449,"equity":85548}],"manual":{},"cons_hist":[],"tp_mentions":[],"src":{"deep":{"products":"HRSG, 원전 BOP, 화력 보일러, 환경설비","competition":"두산에너빌리티(일부), 해외 HRSG 업체(NEM·누터).","customers":"두산에너빌리티, 발전사, 중동 EPC.","sourcing":"강판·튜브.","moat":{"sources":["HRSG 실적","원전 품질 인증"],"reason":"원전 인증과 실적은 진입장벽이지만 HRSG는 경쟁이 있어요."},"outlook":{"summary":"수주잔고 증가로 2027년까지 성장.","upside":["원전·가스복합"],"risks":["원가 상승","높은 부채"]},"explain":{"title":"배열회수보일러(HRSG)·원전 보조기기·화력 보일러를 만드는 발전 기자재 회사","sections":[{"h":"발전 정비·플랜트 기자재 회사는 무엇을 하나요?","p":"발전소는 1년에 한 번 이상 계획예방정비(오버홀)를 하고, 보일러·터빈·발전기·배관을 점검·교체해요. 정비 회사는 발전사와 3~5년 장기 계약을 맺어 안정적인 매출을 얻고, 기자재 회사는 보일러(HRSG, 배열회수보일러)·열교환기·압력용기·비상발전기를 공급해요. 석탄발전 감축과 LNG 복합발전 전환, 데이터센터용 비상·상시 발전기 수요가 동시에 일어나 회사마다 사이클 위치가 달라요."},{"h":"LNG 복합발전과 HRSG","p":"가스터빈으로 1차 발전을 하고, 나오는 600℃ 배기가스로 증기를 만들어 증기터빈을 한 번 더 돌리는 방식이 복합발전이에요. 그 증기를 만드는 장치가 배열회수보일러(HRSG)예요. 미국·중동의 AI 데이터센터 전력 수요로 가스터빈 주문이 2028년 이후까지 밀려 있어, HRSG·열교환기 회사의 수주도 함께 늘고 있어요."},{"h":"원전은 어떻게 만들어지나요? (설계·주기기·보조기기·정비)","p":"원전 한 기(APR1400, 1.4GW)는 약 5~6조원짜리 프로젝트로, 한수원(발주·운영) 아래 한전기술(설계), 두산에너빌리티(원자로·증기발생기·터빈발전기 같은 주기기), 현대건설·삼성물산·대우건설(시공), 그리고 수백 개 보조기기 회사가 붙어요. 보조기기는 밸브·펌프·배관·계측제어(MMIS)·전기설비·크레인·보온재 등으로, 원자력 품질등급(Q-class)과 미국 ASME 'N 스탬프' 인증이 진입장벽이에요. 정비는 한전KPS가 독점적이고 수산인더스트리·일진파워·금화피에스시·우진엔텍 같은 회사가 협력사로 참여해요."},{"h":"비에이치아이는 무엇을 하나요?","p":"LNG 복합발전의 배열회수보일러(HRSG)가 주력이고, 원전 보조기기(BOP: 격납건물 철판·열교환기·저장탱크), 화력 보일러, 환경설비를 만들어요. 신한울 3·4호기·체코 원전 BOP와 국내·중동 LNG 복합발전 HRSG 수주가 늘었어요. 2018~2022년 적자에서 2023년 이후 흑자로 돌아섰어요."}]},"diagnosis":{"verdict":"턴어라운드·수주 확대","summary":"흑자 전환은 LNG 복합·원전 수주가 매출로 바뀐 사이클 회복이에요. 3분기 순이익 798억원에는 일회성 이익이 섞였어요.","cycle":["가스복합 발주","원전 발주"],"structural":["HRSG 기술","원전 BOP 실적"],"check":["체코 원전 BOP 수주","중동 HRSG 수주"]}},"ctx":{"facts":{"report":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000182","date":"20261113","overview":["당사는 발전소공정 및 제철공정에 필요한 발전용 기자재를 설계, 제작, 설치, 시공하는 발전기자재 전문기업입니다.","주된 고객으로는 한전을 비롯한 전력회사 및 발전사업자, 국내외 대형건설사, 포스코를 포함한 제철회사 등이 있습니다.","발전용 기자재는 주기기와 보조기기(Balance of Plant)로 나뉘어지는데, 열을 발생시키는 연료에 따라 발전형태와 주기기가 정해지며, 보조기기류는 발전형태와 상관없이 공통적으로 적용이 되고 있습니다."],"products":["당사의 주요제품인 HRSG, 보일러, 열교환기, 복수기 등은 제품을 반복 생산하는 것이 아니며, 각각의 제품을 생산함에 있어서 제품에 따른 기술 정도나 노력 정도가 다르므로 기간 단위로 한 기준을 정하여 가격 변동 추이를 분석하는 것은 의미가 약하다고 할 수 있습니다."],"mix":[{"label":"HRSG(Heat Recovery Steam Generator)","pct":63.6},{"label":"비에이치아이","pct":22.6}],"materials":["비와 외주가공비 등의 내용입니다."],"channel":["판매방법 등 당사가 생산 판매하는 제품은 전량 주문제작 방식이며, 특정산업에 한정된 고객을대상으로 하고 있고, 국내의 경우 각지에 산재되어 있습니다.","국내에는 국내영업담당 산하에 본사영업팀, 서울사무소, 포항사무소를 운영하고 있습니다."],"strategy":["가) 기술. 품질 경쟁력을 통한 기술 마케팅- 고객의 요구수준을 기술적, 품질적으로 만족시키며, 고객의 잠재 Needs를 선제적으로 발굴하여 경쟁사 대비 우위를 유지 향상시키고자 합니다."],"orders":["주3) 국내 발주처 수주잔량 중 로컬수출에 해당하는 금액은 89,025백만원입니다."],"share":["산업의 특성상 시장점유율에 대한 합리적 추정에 어려움이 있으므로 기재를 생략하였습니다."],"competition":["가) 국내 발전설비 시장의 경우 ① 과거 Boiler는 한국중공업(현 두산에너빌리티)이 한국전력에 독점적 공급을 하였으나, 당사와 Amec Foster Wheeler사간 기술 제휴를 통한 시장 진입 후 여러 국내외 업체가 경쟁 구도를 형성 하고 있습니다.","HRSG의 경우 다수의 기업이 기술제휴를 통한 시장진입으로 경쟁이 심화되어왔으나, 일부 기업의 사업재편 등으로 경쟁강도가 다소 완화될 것으로 예상합니다."],"industry":["발전산업은 국가 기반산업으로서 대규모의 투자와 상당한 수준의 기술을 필요로 합니다.","발전설비의 경우 안정적인 가동 등을 위하여 높은 기술수준이 요구되고 연관프로젝트의 수행경험이 중시되어 진입장벽이 높은 특성을 갖고 있습니다.","오늘날 전세계는 현재 생산전력보다 더 많은 전력을 필요로 하고 있으며, 그 추세는 앞으로도 계속될 것으로 예상됩니다."],"cyclical":["3) 경기변동의 특성 장기간의 계획하에 대규모 자본이 투입되는 공사가 대부분이므로, 국가적인 금융위기 상황이나 발주처의 자금조달 여건, 주요 원자재의 가격 급변, 정부정책 등에 의해 영향을 받는 경향이 있습니다."]},"related":[{"name":"두산에너빌리티","rel":"customer","ind":"energy","code":"034020"},{"name":"대상","rel":"customer","ind":"food","code":"001680"},{"name":"한국전력","rel":"competitor","ind":"energy","code":"015760"},{"name":"한전기술","rel":"competitor","ind":"energy","code":"052690","peer":true},{"name":"한전KPS","rel":"competitor","ind":"energy","code":"051600","peer":true},{"name":"우리기술","rel":"competitor","ind":"energy","code":"032820","peer":true}],"check":{"verdict":["경쟁력 우위 신호","업종 분위기는 좋지 않은데 회사 뉴스는 긍정적이에요. 업황보다 회사 고유 경쟁력이 작동하는 신호예요."],"notes":[]},"signals":[{"date":"2026-11-27","title":"[장중수급포착] 비에이치아이, 외국인/기관 동시 순매수… 주가 +8.41%","url":"https://news.google.com/rss/articles/CBMiXEFVX3lxTE1fcnpRQ1NHT0tvQ2t3cjlZdWpZTlpWU0g2aVRpNkg4a3NtX3pjbTQwTEVjS1JHTi1sTS1xb3V3RElJQlpQNGd6Q1hjZXFEeDhta0hhQlhlWFloOW5u?oc=5","office":"뉴스핌","rel":"self","who":"비에이치아이","cat":null,"sec":"outlook","tone":"0","r":0},{"date":"2026-11-27","title":"에너지 투자 지도 바꾼 전기 부족…두산퓨얼셀·미코부터 비에이치아이·범한퓨얼셀까지 '신바람'","url":"https://news.google.?oc=5","office":"핀포인트뉴스","rel":"self","who":"비에이치아이","cat":null,"sec":"outlook","tone":"0","r":0},{"date":"2026-11-27","title":"산업부, 日 떠난 베트남 원전 수주 총력…한·베 FTA 개정도 검토","url":"https://news.google.com/rss/articles/CBMiWkFVX3lxTFBZUkh3NjVpRXlMVlptUHJQZW9fQXN5aE9uU194UnJCM0hHV3JITzVlLUNtejJuSW02UzA4QU0xS3Y2eDl0d3Y3dUMxcWpWOGEtbkJ5eTlBeHIxd9I