art.fss.or.kr/dsaf001/main.do?rcpNo=20261116001733","date":"20261116","overview":["당사는 투자사업부문을 담당하는 ㈜서연(존속법인)과 자동차 부품제조 부문의 (주)서연이화(신설법인)로 2014년 7월 1일 인적분할을 통해 다른 회사 주식을 소유하여 그 회사의 사업내용을 지배하는 것을 주된 사업으로 하는 지주회사 체제로 전환하였습니다.","당사 (주)서연은 분할에 따른 존속법인으로서 분할 전 회사인 한일이화(주)가 보유한 자회사 및 관계회사 지분 일부를 보유하고 있으며, 이에 따라 자회사 및 관계회사들이 속한 산업환경 및 영업실적에 직간접적으로 영향을 받습니다."],"mix":[{"label":"단순합계","pct":100.0},{"label":"프레스금형, 사출금형, 중장비 CABIN 등","pct":3.3},{"label":"전산서비스, 경영자문, 브랜드로열티,기타사업 등","pct":2.8}],"materials":["자동차 업계 특성상 주요 원재료에 대해서는 완성차 업체와 단가연동제를 실시하고 있기 때문에 주요 원재료의 가격 변동이 손익에 미치는 영향은 거의 없습니다."],"price":[{"item":"DOOR TRIM","now":90390.0,"prev":90226.0,"chg":0.2},{"item":"SEAT","now":216546.0,"prev":217491.0,"chg":-0.4}],"channel":["판매방법 등 1) 자동차 부품 제조업가) 판매조직 제품에 대한 판매는 고객사로부터 신규 아이템을 수주한 후 고객사 생산계획에 맞추어 생산 후 고객사로 납품 수금 처리가 이루어집니다.","① 금형사업부문 : 공개입찰에 의한 수주방식으로 판매가 이루어 집니다."],"strategy":["당사와 종속회사는 국내의 완성차 고객사와의 거래를 시작으로 사업을 진행해 왔으며, 사업을 계속하면서 국내 시장의 성장 한계점을 고려하여 2000년대 초반부터는 해외시장 개척 전략을 실행하는 중 입니다."],"orders":["주요 종속회사 중에 자동차 부품 제조업을 영위하고 있는 종속기업(㈜서연탑메탈 제외)들은 고객사의 가변적인 생산계획에 맞춘 공급을 하고 있기 때문에, 수주잔고의 개념을 적용하기 힘들며, 기간별 고객사의 주문량에 따라 수주의 총액이 결정됩니다."],"competition":["강화: 다양한 산업 분야에 걸친 자회사들의 경쟁력을 향상시킵니다.","각 자회사는 지주회사의 지원을 받아 기술 개발, 시장 진출, 인력 관리 등 다양한 면에서 경쟁 우위를 확보할 수 있습니다."]},"related":[{"name":"기아","rel":"customer","ind":"auto","code":"000270"},{"name":"도요타","rel":"competitor","ind":null,"code":null},{"name":"서연이화","rel":"competitor","ind":"auto","code":"200880","peer":true},{"name":"대원산업","rel":"competitor","ind":"auto","code":"005710","peer":true},{"name":"에코플라스틱","rel":"competitor","ind":"auto","code":"038110","peer":true}],"check":{"verdict":null,"notes":["고객사 뉴스 2건이 부정 쪽이에요. 고객 업황은 보통 1~2분기 뒤 이 회사 주문에 반영돼요.","뉴스 언급량이 직전 같은 기간보다 50% 늘었어요. 시장의 관심이 빠르게 커지는 중이에요."]},"signals":[{"date":"2026-11-27","title":"현대차·기아, 좌석 밑 로봇팔로 시트 오염 닦아내는 자동 세척 특허 공개","url":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNTTNOQnU4RjZwYWZZanhzWWZwWTRjWTdoRm95MXQ1dTdxQUNta2gwRFJtaW9LQl9ncUhaT1A0aXE