:89902,"ni":72662,"equity":329328},{"code":"031980","name":"피에스케이홀딩스","group":"전공정 장비","mcap":2880770,"fy":"2025","rev":207764,"op":73401,"ni":91685,"equity":563252},{"code":"319660","name":"피에스케이","group":"전공정 장비","mcap":2366594,"fy":"2025","rev":457213,"op":88494,"ni":78546,"equity":643293},{"code":"030530","name":"원익홀딩스","group":"전공정 장비","mcap":2211310,"fy":"2025","rev":622992,"op":-418,"ni":27384,"equity":1029339},{"code":"084370","name":"유진테크","group":"전공정 장비","mcap":1719478,"fy":"2025","rev":350324,"op":51672,"ni":42460,"equity":552972},{"code":"281820","name":"케이씨텍","group":"전공정 장비","mcap":1653746,"fy":"2025","rev":382857,"op":59966,"ni":53392,"equity":602041}],"manual":{},"cons_hist":[],"tp_mentions":[],"src":{"deep":{"products":"ALD·CVD 전구체 기화이송 장치(캐니스터), 레벨센서, 스퍼터링 타겟을 만들어요.","competition":"국내외 부품 회사(미국·일본 캐니스터 업체)와 경쟁해요.","customers":"삼성전자 등 반도체 회사와 전구체 소재사예요.","sourcing":"스테인리스·특수 금속 원료를 사요.","moat":{"sources":["고객 인증"],"reason":"고순도 부품이라 인증이 필요하지만 기술 장벽이 아주 높지는 않아요."},"outlook":{"summary":"ALD 공정 확대와 메모리 가동률 상승으로 성장이 이어질 가능성이 커요.","upside":["ALD 공정 확대","타겟 사업 성장"],"risks":["고객 투자 지연","경쟁 심화"]},"explain":{"title":"전구체 기화 장치(캐니스터)·스퍼터링 타겟","sections":[{"h":"캐니스터는 무엇인가요?","p":"ALD·CVD 증착 공정에서는 액체나 고체 전구체를 기체로 만들어 챔버에 정확한 양만큼 보내야 해요. 캐니스터는 전구체를 담아 일정 온도로 데워 기화시키는 고순도 금속 용기이고, 레벨센서는 남은 양을 재요. 전구체가 공기·수분과 반응하면 안 되고 금속 오염이 없어야 해서 정밀 가공·용접·세정 기술이 필요해요."},{"h":"스퍼터링 타겟","p":"금속막을 입힐 때 금속 덩어리(타겟)에 이온을 부딪쳐 원자를 튀어나오게 하는 스퍼터링 공정에 쓰는 소모품이에요."},{"h":"돈을 버는 구조","p":"전구체 소재 회사와 반도체 회사에 캐니스터를 팔고, 세정·재충전 서비스로 반복 매출을 얻어요. 미세화로 ALD 공정이 늘면 수요가 커져요."}]},"diagnosis":{"verdict":"구조적 성장 + 회복","summary":"매출이 2023년 178억원에서 2025년 546억원으로 세 배가 됐고, 2026년 2분기 영업이익 33억원으로 이익률이 19%까지 올랐어요. 2023년 부진은 반도체 감산 사이클이었고, 이후 ALD 공정 확대와 타겟 사업 추가로 성장했어요.","cycle":["2023년 감산으로 소재·부품 수요가 줄었어요."],"structural":["ALD 공정 확대로 캐니스터 수요가 구조적으로 늘어요.","스퍼터링 타겟으로 제품을 넓혔어요."],"check":["영업이익률 15% 이상 유지","해외 고객 매출","타겟 사업 이익"]}},"ctx":{"facts":{"report":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261105000152","date":"20261105","overview":["당사는 각종 전자소자 양산의 핵심 공정인 박막증착 공정과 금속배선 공정에 사용되는 물리증착의 원소재인 스퍼터링 타겟과 원자층 증착의 원소재인 전구체(프리커서)의 기화 이송을 위한 핵심 부품과 장비 솔루션을 제공하는 부품 소재 사업을 영위하고 있습니다.","당사의 제품과 서비스는 크게 전구체 기화이송 기술 사업부문과 스퍼터링 타겟 사업부문으로 구성되어 있습니다.","전구체 기화이송 사업부문은 ALD(Atomic Layer Deposition)이라고 부르는 원자층 증착의 원소재인 전구체의 기화 이송을 위한 캐니스터,초음파레벨센서, 기화기 등 각종 부품과 조립체이자 모듈인 펩(PEB: Precursor Evaporation Box) 등을 제조 판매하고 있으며 당사가 제공하는 전구체 기화이송 기술 부문은 전구체에 대한 높은 이해를 기반으로 전자소자의 양산공정에 최적화된…"],"products":["당사의 주요 제품은 반도체사업부의 제품과 가전제품사업부의 제품으로 구성됩니다.","주요 제품 등의 가격 변동 추이 및 가격변동 원인 당사의 제품 대부분은 주문 제작 방식으로 생산되고 고객의 주문에 따라 제품의 사양이 결정되며, 제품 사양에 따라 판매 가격이 다양합니다."],"materials":["주요 원재료당사는 각종 전자소자 양산 공정인 박막증착 공정, 금속배선 공정에 사용되는 물리증착의 원소재인 스퍼터링 타겟, 원자층 증착의 원소재인 전구체의 기화 이송을 위한 핵심 부품 및 장비 솔루션을 제공하는 부품 소재 사업을 영위하고 있습니다.","때문에 주요 원재료는 Valve, Fitting, 환봉, PCB, 기타 원재료 등으로 구성됩니다."],"mat_price":[{"item":"Valve","now":575249.0,"prev":722268.0,"chg":-20.4},{"item":"Fitting","now":17637.0,"prev":21648.0,"chg":-18.5},{"item":"환봉","now":74145.0,"prev":99776.0,"chg":-25.7},{"item":"압전소자","now":6648.0,"prev":6117.0,"chg":8.7},{"item":"PCB","now":32338.0,"prev":99188.0,"chg":-67.4},{"item":"가전제품사업부","now":680.0,"prev":410.0,"chg":65.9}],"channel":["당사의 판매조직은 국내 영업팀, 해외 영업팀, 영업관리팀으로 구성되어 있으며, 국내 판매는 당사가 직접판매를 하고 있으며 해외 판매는 해외 대리점을 활용하고 있습니다."],"strategy":["당사는 \"전자소자 박막 증착을 위한 원재료의 공급 방법\"이라는 주제로 반도체를 비롯하여 전자소자 산업계에서 원재료인 전구체 기화이송 기술과 스퍼터링 타겟의 제조기술을 기반으로 사업을 영위하고 있습니다."],"customers":["2026년 제22기 3분기 누적 매출액에 따른 주요 매출처 및 비중은 아래의 표와 같습니다."],"orders":["따라서 일반적으로 정기적인 수주나 프로젝트성 수주는 없습니다."]},"related":[{"name":"삼성전자","rel":"customer","ind":"semi","code":"005930"},{"name":"원익IPS","rel":"competitor","ind":"semi","code":"240810","peer":true},{"name":"주성엔지니어링","rel":"competitor","ind":"semi","code":"036930","peer":true},{"name":"피에스케이","rel":"competitor","ind":"semi","code":"319660","peer":true},{"name":"유진테크","rel":"competitor","ind":"semi","code":"084370","peer":true}],"check":{"verdict":["경쟁력 점검 필요","업종이나 경