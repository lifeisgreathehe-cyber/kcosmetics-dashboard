p":10.5,"recovered":"2026Q2","quarters":17,"path":[["2022Q1",23.3],["2022Q2",22.3],["2022Q3",18.3],["2022Q4",12.8],["2023Q1",14.7],["2023Q2",14.2],["2023Q3",14.1],["2023Q4",9.5],["2024Q1",10.9],["2024Q2",13.6],["2024Q3",12.4],["2024Q4",21.6],["2025Q1",10.8],["2025Q2",15.1],["2025Q3",13.8],["2025Q4",15.1],["2026Q1",19.9],["2026Q2",26.1]]}],"peers":[{"code":"067310","name":"하나마이크론","self":true,"mcap":1363074,"fy":"2025","equity":538663,"rev":1534419,"op":127689,"ni":38111},{"code":"036540","name":"SFA반도체","group":"후공정(OSAT)","mcap":1344505,"fy":"2025","rev":367389,"op":-19627,"ni":-19131,"equity":451679},{"code":"131970","name":"두산테스나","group":"후공정(OSAT)","mcap":1097048,"fy":"2025","rev":303874,"op":-941,"ni":1510,"equity":473190},{"code":"033640","name":"네패스","group":"후공정(OSAT)","mcap":368753,"fy":"2025","rev":521439,"op":23761,"ni":16583,"equity":135001},{"code":"200470","name":"에이팩트","group":"후공정(OSAT)","mcap":266794,"fy":"2025","rev":110999,"op":5267,"ni":5226,"equity":89954},{"code":"330860","name":"네패스아크","group":"후공정(OSAT)","mcap":177991,"fy":"2025","rev":114090,"op":4756,"ni":3416,"equity":189595},{"code":"061970","name":"LB세미콘","group":"후공정(OSAT)","mcap":115236,"fy":"2025","rev":479782,"op":-39800,"ni":-150861,"equity":314626},{"code":"097800","name":"윈팩","group":"후공정(OSAT)","mcap":47831,"fy":"2025","rev":75548,"op":-14289,"ni":-13691,"equity":59728}],"manual":{},"src":{"deep":{"products":"메모리·시스템반도체 패키징과 테스트(79.1%), 실리콘 부품(하나머티리얼즈, 13.7%)을 해요.","competition":"국내 OSAT에서 SFA반도체·엘비세미콘, 해외에서 앰코·ASE와 경쟁해요.","customers":"삼성전자·SK하이닉스와 해외 고객이고 베트남·브라질 공장을 운영해요.","sourcing":"기판·와이어·장비를 사요.","moat":{"sources":["규모"],"reason":"후공정은 고객 요구에 맞춰 설비를 깔아야 하는 사업이라 가격 결정력이 약해요."},"outlook":{"summary":"메모리 호황으로 외주 물량이 크게 늘었지만 설비투자와 차입이 같이 커지고 있어요.","upside":["베트남 가동률 상승"],"risks":["외주 물량 감소","차입 부담"]},"explain":{"title":"메모리·시스템반도체 패키징·테스트","sections":[{"h":"후공정(OSAT)은 무엇인가요?","p":"웨이퍼에서 만들어진 칩은 그대로는 쓸 수 없어요. 칩을 잘라(다이싱) 기판에 붙이고(다이 본딩), 전선이나 범프로 연결한 뒤(본딩), 수지로 감싸(몰딩) 완성품 모양으로 만드는 것이 패키징이고, 이후 전기 테스트까지 해 주는 것이 후공정이에요. 하나마이크론은 이를 대신해 주는 외주 회사(OSAT)예요."},{"h":"하나마이크론의 특징","p":"삼성전자·SK하이닉스 메모리 패키징이 주력이고, 베트남 법인이 큰 공장을 운영해요. 여러 칩을 한 패키지에 넣는 SiP, 시스템반도체 테스트도 하고, 자회사 하나머티리얼즈(실리콘 부품)를 연결해요."},{"h":"돈을 버는 구조","p":"고객 칩 생산량에 따라 매출이 늘고 줄며, 패키징 장비 투자가 커서 감가상각비 부담이 커요. 그래서 매출이 늘어도 영업이익률은 5~10%대에 머물고 차입금이 많아요."}]},"diagnosis":{"verdict":"사이클 수혜 성장","summary":"매출이 2020년 5,394억원에서 2025년 1조 5,344억원으로 세 배가 됐고, 2026년 2분기 분기 매출 6,831억원·영업이익 1,423억원으로 크게 늘었어요. 메모리 생산 확대라는 사이클 영향이 크고, 베트남 증설로 물량을 받아낼 능력을 키운 점이 더해졌어요.","cycle":["메모리 생산이 늘어 패키징·테스트 물량이 급증했어요.","고객이 외주를 늘리는 시기에는 이익이 크게 늘어요."],"structural":["베트남 대규모 공장으로 원가 경쟁력을 높였어요.","순차입 약 8,000억원과 큰 설비투자로 현금이 남지 않는 구조예요.","고객 내재화(직접 패키징) 확대는 위험 요인이에요."],"check":["영업이익률 15% 유지 여부","순차입금 추이","삼성·SK 외주 물량 계획"]}},"ctx":{"facts":{"report":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001529","date":"20261113","overview":["당사는 2001년 8월에 설립되어 2005년 10월 코스닥시장에 상장된 반도체 후공정 전문 기업 입니다.","또한, 한국채택국제회계기준 적용 기업으로, 비재무사항에 기재한 연결 대상법인에는 당사를 비롯한 주요 종속회사인 하나머티리얼즈(주)와 HT MICRON SEMICONDUTORES S.A., Hana Micron Vina Co.,Ltd를 포함합니다.","당사 및 주요종속회사는 현재 반도체 제품(패키징) 생산 및 반도체 재료(반도체 식각공정용 실리콘 Part)제품의 생산을 주요 사업으로 영위하고 있습니다."],"products":["반도체재료 부문 수출의 경우 비정규적인 제품 생산 등으로 가격의 등락이 존재하며, 각 거래처 및 모델별 상이한 가격에 따라 가격변동추이를 산출하는 것이 부적합하고 정확한 가격의 변동 추이를 파악하기 어려워 기재를 생략하였음.","기타 매출품목은 품목이 다양하고 가격이 일정치 않으므로 기재하지 않음."],"strategy":["마. 수주상황 연결실체의 제품은 주로 시스템을 통하여 고객사로부터 매월의 Forecast를 자체적으로 파악하고 그에 따른 수요 변화를 예측하고 있습니다."],"customers":["사인 삼성전자와 SK하이닉스의 경우, 반도체 패키징을 당사 외에 앰코코리아, ASE 코리아, SFA반도체, 시그네틱스 등으로부터 공급 받고 있습니다.","시장점유율은반도체 패키징의 국내 시장규모 및 시장점유율에 대한 객관적인 자료가 존재하지 않는 관계로 기재하지 않았습니다."],"orders":["또한, 매일 수시로 시스템을 통하여 고객사의 물량이 접수되고, 수주된 물량은 단기간 내에 매출로 발생하여 별도의 수주관리가 필요하지 않습니다."],"share":["시장점유율은반도체 패키징의 국내 시장규모 및 시장점유율에 대한 객관적인 자료가 존재하지 않는 관계로 기재하지 않았습니다."],"competition":["패키징 사업의 최고의 경쟁수단은 수율 및 품질의 안정성과 고객과의 맞춤형 패키징기술 입니다.","패키지 조립과정은 고가의 시설과 기술, 그리고 각 공정마다 엄격한 품질관리를 필요로 하며 패키징의 문제가 발생시에는 셋트제품까지 문제가 발생되는 중요한 사업으로 최고의 품질이 요구됩니다."],"industry":["반도체 산업의 특성은 첨단 과학 및 산업 모든 분야 전반에 걸쳐 막대한 영향으로 국가의 첨단 기술과 경쟁력을 향상시키는 견인차 역할을 수행하고 있으며, 대규모의 설비투자와 연구개발 투자가 수조원 이상 소요 되어 경기 변동과 기술의 변화속도를 리드해 나가는 타이밍 산업인 관계로 반도체 싸이클을 잘 관리하는 능력이 사업의 중요한 승패요인으로 작용하고 있습니다.","따라서, 패키징 산업은 대규모 종합반도체회사와 설계전문회사, 파운드리 전문회사와의 네트워킹이 잘 이루어져야만 원가, 납기, 품질 등 전체 제품의 경쟁력을 갖출수가 있으며 최근 모바일기기 및 정보기기 시장의 다양화로 패키지 형태는 더욱 더 소형화, 복합다양화가 되어감에 따라 부가가치를 높이는 첨단산업으로서 역할을 하고 있습니다.","이에 따라 반도체 산업은 부가가치 체인별 분업화가 급속히 확산되어 단일기업의 수직계열 생산체제에서 설계전문(Fabless), 파운드리전문, 패키징전담기업 등으로 전문화되고 있습니다."],"cyclical":["(3) 반도체 산업의 특성반도체 산업의 특성은 첨단 과학 및 산업 모든 분야 전반에 걸쳐 막대한 영향으로 국가의 첨단 기술과 경쟁력을 향상시키는 견인차 역할을 수행하고 있으며, 대규모의 설비투자와 연구개발 투자가 수조원 이상 소요 되어 경기 변동과 기술의 변화속도를 리드해 나가는 타이밍 산업인 관계로 반도체 싸이클을 잘 관리하는 능력이 사업의 중요한 승패요인으로 작용하고 있습니다.","또한 FAB 투자규모의 증가에 따라 영향력이 있으며, FAB 투자를 결정하는 가장 큰 요인은 D램, NAND, 시스템반도체 등 반도체 소자를 사용하는 모바일기기, 휴대폰, 태블릿, PC, 서버 등 전자제품 수요 및 국내외 경기의 영향을 받게 됩니다."]},"related":[{"name":"SFA반도체","rel":"customer","ind":"semi","code":"036540"},{"name":"SK하이닉스","rel":"customer","ind":"semi","code":"000660"},{"name":"삼성전자","rel":"customer","ind":"semi","code":"005930"},{"name":"ASE","rel":"customer","ind":null,"code":null},{"name":"앰코","rel":"customer","ind":null,"code":null},{"name":"두산테스나","rel":"competitor","ind":"semi","code":"131970","peer":true},{"name":"LB세미콘","rel":"competitor","ind":"semi","code":"061970","peer":true},{"name":"네패스","rel":"competitor","ind":"semi","code":"033640","peer":true},{"name":"네패스아크","rel":"competitor","ind":"semi","code":"330860","peer":true}],"check":{"verdict":["업황 순풍","회사와 업종 뉴스가 함께 긍정적이에요. 실적 개선의 상당 부분이 업황(사이클) 덕분일 수 있어, 정점 신호도 같이 지켜보세요."],"notes":["고객사 뉴스 8건이 긍정 쪽이에요. 고객 업황은 보통 1~2분기 뒤 이 회사 주문에 반영돼요."]},"signals":[{"date":"2026-11-27","title":"아산시 음봉면, 하나마이크론㈜과 사랑의 김장 나눔 실천","url":"https://news.google.com/rss/articles/CBMibkFVX3lxTE9YTk16NmM4N3c4c0xfbk5JN0JLd09Eb2VKWm5Ca0lMazlTUmd0LVNuUmhsWXN3QUdJSzRLWG5DOVR5aEM0M0dRZndWQmhOYXJELXY2YTBwQVZwVFVyclNmYWdUblZUV1dHTlJLS21n?oc=5","office":"아산포커스","rel":"self","who":"하나마이크론","cat"