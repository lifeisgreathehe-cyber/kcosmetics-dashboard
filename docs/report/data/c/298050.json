532123,"op":65482,"ni":61303,"equity":483466},{"code":"006380","name":"카프로","group":"정밀·스페셜티","mcap":618529,"fy":"2025","rev":24638,"op":-21120,"ni":-32360,"equity":63404},{"code":"161000","name":"애경케미칼","group":"정밀·스페셜티","mcap":431773,"fy":"2025","rev":1452335,"op":-10193,"ni":-2949,"equity":715478},{"code":"069260","name":"TKG휴켐스","group":"정밀·스페셜티","mcap":421274,"fy":"2025","rev":1127691,"op":65615,"ni":59907,"equity":796893},{"code":"014830","name":"유니드","group":"정밀·스페셜티","mcap":337920,"fy":"2025","rev":1338758,"op":87909,"ni":65259,"equity":1148601},{"code":"092230","name":"KPX홀딩스","group":"정밀·스페셜티","mcap":300457,"fy":"2025","rev":1163726,"op":42964,"ni":79312,"equity":1228459}],"manual":{},"cons_hist":[],"tp_mentions":[{"date":"2026-08-04","broker":null,"tp":260000.0,"title":"“HS효성첨단소재, 본업 호조에도 성장 우려…목표가는 26만 하향”- ...","url":"https://n.news.naver.com/mnews/article/018/0006343832"}],"src":{"deep":{"products":"타이어코드, 탄소섬유, 아라미드, 에어백 원단, 스틸코드예요.","competition":"타이어코드는 코오롱인더·중국 업체, 탄소섬유는 일본 도레이·중국 업체와 경쟁해요.","customers":"미쉐린·브리지스톤·굿이어 등 세계 타이어 회사와 수소 탱크·풍력 회사가 고객이에요.","sourcing":"PET 칩·나일론·아크릴로니트릴을 조달해요.","moat":{"sources":["세계 1위","고객 인증"],"reason":"타이어코드는 세계 1위와 타이어사 인증이 진입 장벽이에요."},"outlook":{"summary":"타이어코드가 안정적 이익을 주고 탄소섬유가 성장 옵션이지만 차입이 부담이에요.","upside":["탄소섬유 수요","차입 감축"],"risks":["중국 탄소섬유 공급과잉","이자 부담"]},"explain":{"title":"HS효성첨단소재: 타이어코드 세계 1위, 탄소섬유·아라미드를 하는 산업소재사","sections":[{"h":"타이어코드란?","p":"타이어 고무 안에 들어가 형태를 잡고 하중을 견디게 하는 보강 섬유예요. 폴리에스터·나일론·아라미드로 만들고, HS효성첨단소재가 폴리에스터 타이어코드 세계 점유율 약 45%로 1위예요. 타이어 교체 수요가 대부분이라 경기에 덜 민감한 편이에요."},{"h":"탄소섬유와 아라미드","p":"탄소섬유는 강철보다 가볍고 강해서 수소 탱크·풍력 블레이드·항공기에 쓰여요(브랜드 '탄섬'). 아라미드는 방탄복·광케이블 보강재에 쓰이는 고강도 섬유예요. 둘 다 미래 성장 사업이지만 중국 증설로 가격 경쟁이 심해요."}]},"diagnosis":{"verdict":"사이클 회복 + 주력 경쟁력 견조","summary":"3분기 영업이익 516억원으로 전년 대비 +167%지만 전 분기보다는 33% 줄었어요. 순이익 164억원으로 흑자 전환했어요. 타이어코드는 세계 1위의 안정적 사업이고, 이익 변동은 주로 탄소섬유·아라미드 가격(중국 공급과잉)과 원료 가격 같은 사이클 요인이에요.","cycle":["타이어 교체 수요 회복","탄소섬유·아라미드는 중국 증설로 가격 약세"],"structural":["타이어코드 세계 1위와 글로벌 타이어사 인증이 견고해요.","차입이 많아 이자 부담이 커요."],"check":["탄소섬유 가격과 수소 탱크 수요","차입 감축","4분기 비수기"]}},"ctx":{"facts":{"report":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001399","date":"20261113","overview":["당사의 사업은 제품 및 제조공정의 특징, 시장 및 판매방법의 특징 등에 따라 산업자재, 섬유 및 기타 부문으로 구분할 수 있습니다.","당사의 연결기준 2026년 3분기 매출액은 2,681,515백만원이며, 그 중 산업자재부문 매출액은 2,742,156백만원입니다.","산업자재 부문에는 타이어보강재, 산업용 원사, 카페트, 아라미드, 탄소섬유 등이 있습니다."],"products":["서비스 에이치에스효성첨단소재㈜의 종속회사는 19개사(지배회사 제외)이며, 주요종속회사 11개사를 중심으로 '주요 제품 등의 매출', '주요 제품 등의 가격변동 추이', '가격변동 산출기준 및 가격변동 원인'을 작성하였습니다."],"materials":["주요 매입처 중 효성티앤씨, Hyosung DongNai는 계열회사 입니다."],"channel":["는 Local 및 직수출, 내수직판으로 구분되어 있습니다.","심도있는 시장조사를 통해 신규거래선을 개발, 관리하고 적극적인 신시장 개척을 통해 당사의 상권을 강화하고 있습니다."],"customers":["비중 2026년 1~9월 지배회사의 주요 매출처는 HS HYOSUNG VIETNAM CO LTD(16.25%), HS Hyosung USA, Inc.(12.89%), HS HYOSUNG LUXEMBOURG S.A.(12.83%), 한국타이어앤테크놀로지(주)(7.39%), HS HYOSUNG CARBON MATERIALS (JIANGSU) (5.65%), HYOSUNG DONG NAI COMPANY…"],"industry":["]산업용 섬유는 자동차용, 토목건축용, 농업용, 공업용, 운송용, 포장용, 스포츠용 등 의류산업을 제외한 전 산업에서 다양한 용도로 사용되고 있으며, 고객들의 경량화, 고기능화, 고급화 요구에 따라 소재 및 신제품 개발을 통해 사업 영역이 지속 확대되고 있습니다.","이에 따라 제품 개발을 위한 지속적인 R&D 투자가 필요하며, 제품을 납품하기 위해 고객에게 Approval을 받아야 하는 과정이 있어 진입장벽이 높은 산업입니다.","[산업의 성장성]당사의 주요 제품이자 뛰어난 품질을 바탕으로 세계 시장을 이끌고 있는 폴리에스터 타이어코드 및 Seatbelt용 원사, Airbag용 원단과 자동차용 카페트 사업은 자동차 시장의 성장과 더불어 동반 성장이 예상됩니다."],"cyclical":["[경기변동의 특성]당사는 자동차와 연관된 제품을 다수 생산하고 있어, 경제 상황에 따른 자동차 수요의 변화가 사업에 영향을 줄 수 있습니다.","[경기변동의 특성]시황 변화에 따른 수요의 변화는 있으나 섬유 산업은 장기적으로 지속적인 성장세를 유지하고 있습니다."],"utilization":89.28},"related":[{"name":"한국타이어앤테크놀로지","rel":"customer","ind":"auto","code":"161390"},{"name":"효성티앤씨","rel":"supplier","ind":"chem","code":"298020"},{"name":"코오롱인더","rel":"competitor","ind":"chem","code":"120110"},{"name":"도레이","rel":"competitor","ind":null,"code":null},{"name":"롯데정밀화학","rel":"competitor","ind":"chem","code":"004000","peer":true},{"name":"SKC","rel":"competitor","ind":"chem","code":"011790","peer":true}],"check":{"verd