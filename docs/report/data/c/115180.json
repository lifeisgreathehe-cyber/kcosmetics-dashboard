ll,"path":[["2023Q4",18.4],["2024Q1",18.0],["2024Q2",17.6],["2024Q3",13.7],["2024Q4",11.0],["2025Q1",13.5],["2025Q2",13.0],["2025Q3",14.2],["2025Q4",13.1],["2026Q1",10.8],["2026Q2",9.4],["2026Q3",10.3]]}],"peers":[{"code":"115180","name":"큐리언트","self":true,"mcap":566799,"fy":"2025","equity":34040,"rev":6980,"op":-29760,"ni":-30050},{"code":"326030","name":"SK바이오팜","group":"신약 상업화·후기 임상","mcap":7525859,"fy":"2025","rev":706740,"op":203940,"ni":266950,"equity":813040},{"code":"028300","name":"HLB","group":"신약 상업화·후기 임상","mcap":4042530,"fy":"2025","rev":84170,"op":-104220,"ni":-220500,"equity":418460},{"code":"140410","name":"메지온","group":"신약 상업화·후기 임상","mcap":1974100,"fy":"2025","rev":7910,"op":-16770,"ni":-34930,"equity":17190},{"code":"067630","name":"HLB생명과학","group":"신약 상업화·후기 임상","mcap":301154,"fy":"2025","rev":45750,"op":-22030,"ni":-99790,"equity":297350},{"code":"950160","name":"코오롱티슈진","group":"신약 상업화·후기 임상","mcap":288699,"fy":null,"equity":null},{"code":"215600","name":"신라젠","group":"신약 상업화·후기 임상","mcap":270027,"fy":null,"equity":null}],"manual":{},"src":{"deep":{"products":"텔라세벡(결핵), 아드릭세티닙(CDK7 항암)","competition":"결핵: 존슨앤드존슨 베다퀼린.","customers":"론자(협력).","sourcing":"-","moat":{"sources":[],"reason":"초기."},"outlook":{"summary":"자금 조달이 변수.","upside":["기술수출"],"risks":["증자"]},"explain":{"title":"결핵 신약 텔라세벡·CDK7 항암제, 론자와 ADC 협력","sections":[{"h":"기술수출(라이선스 아웃) 계약은 어떻게 돈이 되나요?","p":"국내 바이오텍은 신약 후보물질이나 기술(플랫폼)을 빅파마에 넘기고 ① 계약금(업프론트, 보통 총액의 3~10%), ② 개발·허가·매출 단계마다 받는 마일스톤, ③ 출시 후 매출의 일정 비율 로열티(보통 2~15%)를 받아요. 발표되는 '총 계약 규모 3조원'은 모든 단계가 성공했을 때의 최대치라, 실제로는 계약금만 확정이고 나머지는 임상 성공 확률을 곱해서 봐야 해요. 빅파마가 우선순위를 바꿔 권리를 반환하는 일도 흔해요."},{"h":"플랫폼 기술이란?","p":"약 하나가 아니라 여러 약에 반복해서 쓸 수 있는 기술이에요. 정맥주사를 피하주사로 바꾸는 효소(알테오젠 ALT-B4), 항체에 독성 약물을 붙이는 ADC 링커(리가켐), 약을 뇌혈관장벽(BBB) 너머로 보내는 셔틀(에이비엘 그랩바디-B), 약효를 한 달 이상 늘리는 장기지속형 주사(펩트론·인벤티지랩), 먹는 펩타이드(디앤디파마텍) 등이 있어요. 플랫폼 회사는 한 번 검증되면 계약을 여러 건 맺을 수 있어 가치가 커지지만, 첫 검증(임상 데이터·대형 계약) 전에는 기대만으로 주가가 움직여요."},{"h":"임상 단계별 성공 확률","p":"미국 바이오협회(BIO) 통계로 임상 1상에 들어간 약이 허가까지 갈 확률은 평균 약 8%예요. 단계별로는 1상 → 2상 약 52%, 2상 → 3상 약 29%, 3상 → 허가 신청 약 58%, 허가 신청 → 승인 약 90%예요. 항암제는 평균보다 낮고(1상 기준 약 5%), 희귀질환·혈액질환은 높아요. 그래서 2상 약물의 '출시까지 확률'은 대략 15~25%로 봐야 해요. 이 대시보드의 rNPV는 이 확률을 기본으로 회사·적응증별로 조정했어요."},{"h":"큐리언트는 무엇을 하나요?","p":"결핵·부룰리 궤양 치료 후보 '텔라세벡'(Q203, 결핵균 에너지 생성 차단)과 혈액암·고형암 후보 '아드릭세티닙'(Q901, CDK7 억제)을 개발해요. 2026년 11월 스위스 론자와 ADC 관련 협력을 발표했어요."}]},"diagnosis":{"verdict":"초기 임상","summary":"최근 4개 분기 영업손실 367억원, 현금이 적어 자금 조달이 관건이에요.","cycle":[],"structural":[],"check":["Q901 데이터","기술수출","자금 조달"]}},"ctx":{"facts":{},"related":[{"name":"론자","rel":"customer","ind":null,"code":null},{"name":"SK바이오팜","rel":"competitor","ind":"bio","code":"326030","peer":true},{"name":"HLB","rel":"competitor","ind":"bio","code":"028300","peer":true},{"name":"HLB생명과학","rel":"competitor","ind":"bio","code":"067630","peer":true},{"name":"메지온","rel":"competitor","ind":"bio","code":"140410","peer":true}],"check":{"verdict":["경쟁력 점검 필요","업종이나 경쟁사 뉴스는 나쁘지 않은데 회사 뉴스만 부정적이에요. 점유율·제품 경쟁력이 약해지는지 확인이 필요해요."],"notes":["고객사 뉴스 3건이 중립 쪽이에요. 고객 업황은 보통 1~2분기 뒤 이 회사 주문에 반영돼요."]},"signals":[{"date":"2026-11-27","title":"큐리언트, 706억 규모 유상증자 경쟁률 106.33% 기록","url":"https://news.google.com/rss/articles/CBMia0FVX3lxTE5STEtKYzZpa05nTE5nVXNRRE9BbVJWc2NlSzFiZ0xVU2FpajNfbmpnZ3g2Tjl6YkI5ako4c1JvTzJUZ0pxRDIzUkJ5S2tOV2RUaHFXTEVScHZsdkEwY1BHUFhYZGJrazlkNHNR?oc=5","office":"히트뉴스","rel":"self","who":"큐리언트","cat":"risk","sec":"outlook","tone":"-","r":28},{"date":"2026-11-27","title":"큐리언트, 706억원 유상증자 구주주 청약률 106.33%","url":"https://news.google.com/rss/articles/CBMiZEFVX3lxTE1kclp2MjlEdDVSdTEwdXo4ZVRnZzF2UHNGbjBGNk5GMC16UU1VdWtERUtYZmcyTVQzTFRCb3owM2toT285NmtoWnQzVHZyQklSV01scUVGQ2ZVSWNyLUVzTnR5aVI?oc=5","office":"메디포뉴스","rel":"self","who":"큐리언트","cat":"risk","sec":"outlook","tone":"-","r":28},{"date":"2026-11-27","title":"큐리언트, 유증 초과 청약에 '급등'…\"다음은 지수편입\" [종목+]","url":"https://news.google.com/rss/articles/CBMiWkFVX3lxTE5qVXdSSm8xOGlJWndmOWRiVlVkcEcxZnNEQmVQX0xMN052TDRkMU9KRTB4eVhRZkZGUDJtOWZMM